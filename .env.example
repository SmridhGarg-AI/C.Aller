# Copy to .env.local. Never commit .env.local or real credentials.
# Supabase project settings; public publishable key only (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Choose a Gemini model enabled for your Google API account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Replace contact information before making Open Food Facts requests in production.
OPEN_FOOD_FACTS_USER_AGENT=AllerMatrix/0.1 (contact: your-email@example.com)
# Optional browser smoke test credentials, isolated test project/accounts only.
# Set these in the test shell, not NEXT_PUBLIC variables. Never use a personal account.
# Default browser suite clears remote credentials in its child server.
# Opt in explicitly to isolated live auth tests using E2E_LIVE=1 in your shell.
E2E_LIVE=0
E2E_EMAIL=
E2E_PASSWORD=
E2E_SIGNUP_EMAIL=
# Payments are intentionally not implemented. There is no supported provider or price variable yet.
